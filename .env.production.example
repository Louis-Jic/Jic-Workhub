# Copy values into an untracked .env.production or inject them through CI.
# Firebase Web config is public, but this repository keeps environment values out
# of source control so staging and production cannot be mixed accidentally.
VITE_APP_ENV=production
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-east1
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_USE_FIREBASE_EMULATORS=false
VITE_APP_CHECK_SITE_KEY=
VITE_APP_CHECK_DEBUG=false
